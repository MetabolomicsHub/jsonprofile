<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<suppressions>
  <!-- Existing public APIs have no Javadocs yet; keep new formatting and style checks active. -->
  <suppress checks="MissingJavadoc(Type|Method)" files=".*"/>
  <!-- Preserve established domain acronyms in public type names and tests. -->
  <suppress
      checks="AbbreviationAsWordInName"
      files=".*(CVTermValueConstraint|ParentCVTermConstraint|CVTermConstraint|CVListConstraint|CVTermEnumConstraint|DefaultConstraintCheckers|ConformanceSmokeTest)\.java"/>
</suppressions>
