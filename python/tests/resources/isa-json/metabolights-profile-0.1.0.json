      "enforcement_level": "required",
      "value_constraint": {
        "type": "items-count",
        "min_occurs": 1
      }
    },
    "$.studies[0].protocols[*]": {
      "enforcement_level": "required",
      "requirements": [
        {
          "code": "M-000401",
          "description": "Name, description and protocol type are required",
          "enforcement_level": "required",
          "required_properties": [
            "name",
            "description",
            "protocolType"
          ]
        },
        {
          "code": "M-000402",
          "description": "Mass spectrometry protocol MUST have a parameter type 'Instrument'",
          "enforcement_level": "required",
          "value_constraint": {
            "type": "items-count",
            "precondition": {
              "evaluations": [
                {
                  "json_path": "protocolType",
                  "constraint": {
