            },
            "item_value_jsonpath_list": [
              ".parameters[*]"
            ],
            "item_value_match_constraint": {
              "type": "string-enum",
              "json_path": "parameterName.annotationValue",
              "options": [
                "Scan polarity"
              ]
            },
            "min_match": 1,
            "max_match": 1
